# ---- Browser (safe to expose) ----
# From your Supabase project: Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Server only (set in Vercel → Project → Settings → Environment Variables) ----
# Backup proxy for library catalog lookups (optional)
SCRAPERAPI_KEY=

# Shared cache + rate limits (optional; add the Upstash Redis integration in Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI recommendations (optional; the section stays hidden until all three are set)
# AI_PROVIDER = anthropic | openai   (openai = any OpenAI-compatible API)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
